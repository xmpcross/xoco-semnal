---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Icon from "@/components/Icon.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostCard from "@/components/PostCard.astro";
import ShareButton from "@/components/ShareButton.astro";
import ShareSheet from "@/components/ShareSheet.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  categories,
  categoryAccent,
  categorySlug,
  formatDate,
  getReadMinutes,
  getRelated,
  authorHref,
  postSlug,
  tagSlug,
  visiblePosts,
  type Post,
} from "@/lib/posts";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  return allPosts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, allPosts },
  }));
}

interface Props {
  post: Post;
  allPosts: Post[];
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const related = getRelated(allPosts, post);
const currentIndex = allPosts.findIndex((item) => item.id === post.id);
const previousPost = currentIndex > 0 ? allPosts[currentIndex - 1] : undefined;
const nextPost =
  currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : undefined;
const data = post.data;
const slug = postSlug(post);
const readMinutes = getReadMinutes(post);
const categoryHref = `/category/${categorySlug(data.category)}/`;
const articleUrl = new URL(`/post/${slug}/`, siteConfig.siteUrl).toString();
const imageUrl = data.cover.src.src;
const absoluteImageUrl = new URL(imageUrl, siteConfig.siteUrl).toString();
const demoPublisherName = "Example Editorial Team";
const headings = (post.body ?? "")
  .split("\n")
  .filter((line) => line.startsWith("## "))
  .map((line) => {
    const text = line.replace(/^##\s+/, "").trim();
    const id = text
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, "")
      .trim()
      .replace(/\s+/g, "-");
    return { text, id };
  });
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.excerpt,
  image: absoluteImageUrl,
  datePublished: data.date.toISOString(),
  dateModified: data.date.toISOString(),
  timeRequired: `PT${readMinutes}M`,
  author: {
    "@type": "Person",
    name: data.author.name,
  },
  publisher: {
    "@type": "Organization",
    name: demoPublisherName,
  },
  mainEntityOfPage: articleUrl,
};
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  image={absoluteImageUrl}
  type="article"
  structuredData={structuredData}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen">
    <article class="mx-auto max-w-7xl px-6 pt-10 pb-16 lg:px-10">
      <header class="opener">
        <div>
          <a
            href={categoryHref}
            class:list={["category-chip text-[11px]", categoryAccent[data.category]]}
          >
            {data.category}
          </a>
        </div>
        <h1
          class="mt-5 max-w-5xl font-display text-[clamp(2.35rem,5.2vw,4.4rem)] leading-[0.99] font-extrabold text-balance"
        >
          {data.title}
        </h1>
        <p class="mt-6 max-w-3xl text-pretty text-xl leading-relaxed text-muted-foreground">
          {data.excerpt}
        </p>

        <div
          class="mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-5 border-t border-border pt-4"
        >
          <div
            class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[11px] tracking-[0.14em] uppercase"
          >
            <span class="inline-flex min-w-0 items-center gap-1.5 text-muted-foreground">
              <Icon name="user" class="h-3 w-3" />
              By <a
                href={authorHref(data.author.name)}
                class="story-link text-foreground hover:text-primary">{data.author.name}</a
              >
            </span>
            <span class="text-muted-foreground/50" aria-hidden="true">/</span>
            <time
              class="inline-flex min-w-0 items-center gap-1.5 text-muted-foreground"
              datetime={data.date.toISOString()}
            >
              <Icon name="calendar" class="h-3 w-3" />
              {formatDate(data.date, "long")}
            </time>
            <span class="text-muted-foreground/50" aria-hidden="true">/</span>
            <span class="inline-flex min-w-0 items-center gap-1.5 text-muted-foreground">
              <Icon name="clock" class="h-3 w-3" />
              {readMinutes} min read
            </span>
          </div>

          <ShareButton />
        </div>
      </header>

      <figure class="mt-10">
        <div class="story-frame settle h-[clamp(260px,42vw,540px)]">
          <Image
            src={data.cover.src}
            alt={data.cover.alt}
            widths={[640, 960, 1200, 1600, 2000]}
            sizes="(min-width: 1280px) 1216px, calc(100vw - 3rem)"
            loading="eager"
            decoding="async"
            class="h-full w-full object-cover object-center"
          />
        </div>
        <figcaption
          class="mt-2.5 font-mono text-[11px] tracking-[0.14em] text-muted-foreground uppercase"
        >
          Image: <a
            href={data.cover.creditUrl}
            rel="noreferrer"
            class="story-link hover:text-primary">{data.cover.creditName}</a
          >
        </figcaption>
      </figure>

      <div class="mt-16 grid gap-8 lg:grid-cols-[1fr_minmax(0,720px)_1fr]">
        <aside class="article-rail hidden self-start lg:sticky lg:block">
          <div class="article-rail-scroll space-y-8 overflow-y-auto pr-4">
            <nav aria-label="All Categories">
              <ul class="space-y-2 text-sm">
                <li class="eyebrow mb-4 text-muted-foreground">All Categories</li>
                {
                  categories.map((category) => (
                    <li>
                      <a
                        href={`/category/${categorySlug(category)}/`}
                        class:list={[
                          "story-link",
                          category === data.category
                            ? "text-primary"
                            : "text-muted-foreground hover:text-foreground",
                        ]}
                      >
                        {category}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>

            {
              data.tags.length > 0 && (
                <nav aria-labelledby="article-tags">
                  <p id="article-tags" class="eyebrow mb-4 text-muted-foreground">
                    Tags
                  </p>
                  <ul class="flex flex-wrap gap-2">
                    {data.tags.map((tag) => (
                      <li>
                        <a
                          href={`/tag/${tagSlug(tag)}/`}
                          class="button-quiet inline-flex px-2.5 py-1 font-mono text-[10px] tracking-[0.18em] uppercase"
                        >
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )
            }

            {
              headings.length > 0 && (
                <nav aria-labelledby="article-toc">
                  <p id="article-toc" class="eyebrow mb-4 text-muted-foreground">
                    Table of Contents
                  </p>
                  <ol class="space-y-3 text-sm">
                    {headings.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.id}`}
                          class="block leading-snug text-muted-foreground transition-colors hover:text-primary"
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              )
            }
          </div>
        </aside>
        <div class="min-w-0">
          <div class="article-body">
            <Content />
          </div>

          <div class="mt-10">
            <ShareButton variant="button" />
          </div>

          {
            (previousPost || nextPost) && (
              <nav
                class="mt-14 grid gap-x-8 gap-y-6 rule-top pt-5 sm:grid-cols-2"
                aria-label="Previous and next articles"
              >
                <div>
                  {previousPost && (
                    <a href={`/post/${postSlug(previousPost)}/`} class="story-tile group block">
                      <span class="eyebrow text-muted-foreground">Previous</span>
                      <span class="story-headline mt-2.5 block font-display text-xl leading-[1.14] font-bold text-balance">
                        {previousPost.data.title}
                      </span>
                    </a>
                  )}
                </div>
                <div class="sm:border-l sm:border-border sm:pl-8">
                  {nextPost && (
                    <a href={`/post/${postSlug(nextPost)}/`} class="story-tile group block">
                      <span class="eyebrow text-muted-foreground">Next</span>
                      <span class="story-headline mt-2.5 block font-display text-xl leading-[1.14] font-bold text-balance">
                        {nextPost.data.title}
                      </span>
                    </a>
                  )}
                </div>
              </nav>
            )
          }

          <div class="mt-14">
            <NewsletterSignup variant="compact" />
          </div>
        </div>
      </div>
    </article>

    <section class="reveal mx-auto max-w-7xl px-6 pt-16 lg:px-10">
      <div class="section-rule rule-top"></div>
      <div class="mt-4 mb-7 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
        <div class="max-w-xl">
          <h2 class="font-display text-3xl leading-[0.98] font-extrabold md:text-[2.6rem]">
            Keep reading
          </h2>
          <p class="mt-2.5 text-pretty text-sm leading-6 text-muted-foreground">
            More from the same desk, and what ran alongside it.
          </p>
        </div>
        <a
          href="/all-news/"
          class="button-quiet inline-flex min-h-9 items-center px-3.5 font-mono text-[10px] font-semibold tracking-[0.22em] uppercase"
        >
          All stories
        </a>
      </div>
      <div class="grid-cards col-rules-3 grid gap-x-8 gap-y-10 md:grid-cols-3">
        {related.map((relatedPost) => <PostCard post={relatedPost} />)}
      </div>
    </section>
  </main>
  <SiteFooter />
  <ShareSheet title={data.title} url={articleUrl} />
</BaseLayout>

<style>
  .article-body :global(p) {
    margin: 1.35rem 0;
    color: color-mix(in oklch, var(--foreground) 92%, transparent);
    font-size: 1.1875rem;
    line-height: 1.72;
    text-wrap: pretty;
  }

  /* Opening paragraph carries the drop cap and a slightly larger setting, the
     way a printed feature opens. The child combinator has to sit outside
     `:global()`, or the compiled selector is invalid. */
  .article-body > :global(p:first-child) {
    margin-top: 0;
    font-size: 1.3125rem;
    line-height: 1.6;
  }

  .article-body > :global(p:first-child::first-letter) {
    float: left;
    margin: 0.34rem 0.6rem 0 0;
    color: var(--foreground);
    font-family: var(--font-display);
    font-size: 4.1rem;
    font-weight: 800;
    line-height: 0.78;
  }

  .article-body :global(:is(h2, h3, h4, h5, h6)) {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.018em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .article-body :global(h2) {
    margin: 3.25rem 0 1.25rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    font-size: clamp(1.75rem, 3vw, 2.2rem);
  }

  .article-body :global(h3) {
    margin: 2.5rem 0 1rem;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    font-size: clamp(1.4rem, 2.25vw, 1.7rem);
  }

  .article-body :global(:is(h4, h5, h6)) {
    margin: 2rem 0 0.85rem;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
  }

  .article-body :global(blockquote) {
    margin: 2.75rem 0;
    border-top: 2px solid var(--foreground);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .article-body :global(blockquote p) {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }

  .article-body :global(:is(ul, ol)) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    font-size: 1.1875rem;
    line-height: 1.72;
  }

  .article-body :global(li) {
    margin: 0.55rem 0;
    padding-left: 0.35rem;
    color: color-mix(in oklch, var(--foreground) 92%, transparent);
  }

  .article-body :global(li::marker) {
    color: var(--primary);
  }

  .article-body :global(img) {
    margin: 2.5rem 0;
    width: 100%;
  }

  .article-body :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .article-body :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: color 200ms var(--ease-out);
  }

  .article-body :global(a:hover) {
    color: var(--foreground);
  }

  .article-body :global(strong) {
    font-weight: 650;
  }
</style>
