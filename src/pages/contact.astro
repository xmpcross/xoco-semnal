---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout
  title="Contact"
  description={`Contact ${siteConfig.name} for editorial, advertising, partnerships, and general publication inquiries.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="min-h-screen">
    <section class="mx-auto max-w-4xl px-6 pt-12 lg:px-10">
      <p class="eyebrow text-primary">Contact</p>
      <h1 class="mt-3 font-display text-5xl leading-[0.95] font-extrabold md:text-7xl">
        Get in touch
      </h1>
      <p class="mt-6 max-w-2xl text-pretty text-xl text-muted-foreground">
        Use this page for editorial tips, partnerships, advertising, and general publication
        inquiries.
      </p>
    </section>

    <section class="mx-auto grid max-w-4xl gap-6 px-6 pt-14 md:grid-cols-2 lg:px-10">
      <article class="border border-border bg-card p-6">
        <h2 class="font-display text-2xl font-bold">Editorial</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">
          Send story ideas, corrections, and publication questions.
        </p>
        <a
          class="story-link mt-5 inline-block text-sm text-primary"
          href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a
        >
      </article>

      <article class="border border-border bg-card p-6">
        <h2 class="font-display text-2xl font-bold">Advertising</h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">
          Ask about sponsorships, display placements, newsletter inventory, and editorial
          partnerships.
        </p>
        <a
          class="story-link mt-5 inline-block text-sm text-primary"
          href={`mailto:${siteConfig.email}?subject=Advertising inquiry`}>Advertise with us</a
        >
      </article>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
