---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="grid min-h-[60vh] place-items-center px-6 text-center">
    <div>
      <p class="eyebrow text-muted-foreground">404</p>
      <h1 class="mt-3 font-display text-5xl font-bold">Page not found</h1>
      <p class="mt-4 max-w-md text-muted-foreground">
        That story may have moved, or the URL may be mistyped.
      </p>
      <a href="/" class="story-link mt-6 inline-block text-primary">Back to the front page</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
