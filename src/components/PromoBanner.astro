---
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  href?: string;
  linkLabel?: string;
}

const {
  eyebrow = "Editorial intelligence",
  title = "One focused read before the market opens.",
  body = "The desk picks a single story each morning and explains what actually changed, in about four minutes.",
  href = "/#newsletter",
  linkLabel = "Join the briefing",
} = Astro.props;
---

<aside class="rule-top flex flex-col pt-3">
  <p class="eyebrow text-primary">{eyebrow}</p>
  <p class="mt-3 font-display text-xl leading-[1.1] font-bold text-balance">{title}</p>
  <p class="mt-3 text-pretty text-sm leading-6 text-muted-foreground">{body}</p>
  <a
    href={href}
    class="button-primary mt-5 inline-flex min-h-11 items-center justify-center px-5 text-sm font-semibold"
  >
    {linkLabel}
  </a>
</aside>
