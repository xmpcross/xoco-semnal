---
import {
  categories,
  categoryAccent,
  categorySlug,
  formatDate,
  postHref,
  type Post,
} from "@/lib/posts";

interface Props {
  posts: Post[];
  title?: string;
}

const { posts, title = "The desk index" } = Astro.props;

const entries = categories
  .map((category) => {
    const inCategory = posts.filter((post) => post.data.category === category);
    return { category, count: inCategory.length, lead: inCategory[0] };
  })
  .filter((entry) => entry.lead);
---

<section class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10" aria-labelledby="desk-index-heading">
  <div class="section-rule rule-top"></div>
  <div class="mt-4 mb-7 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <div class="max-w-xl">
      <h2
        id="desk-index-heading"
        class="font-display text-3xl leading-[0.98] font-extrabold md:text-[2.6rem]"
      >
        {title}
      </h2>
      <p class="mt-2.5 text-pretty text-sm leading-6 text-muted-foreground">
        Every desk, its story count, and the piece it is leading with right now.
      </p>
    </div>
    <a
      href="/all-news/"
      class="button-quiet inline-flex min-h-9 items-center px-3.5 font-mono text-[10px] font-semibold tracking-[0.22em] uppercase"
    >
      Full archive
    </a>
  </div>

  <ul class="grid-cards col-rules-3 grid gap-x-8 md:grid-cols-3">
    {
      entries.map((entry) => (
        <li class="border-t border-border py-4">
          <div class="flex items-baseline justify-between gap-3">
            <a
              href={`/category/${categorySlug(entry.category)}/`}
              class:list={["eyebrow story-link", categoryAccent[entry.category]]}
            >
              {entry.category}
            </a>
            <span class="font-mono text-[11px] text-muted-foreground">
              {String(entry.count).padStart(2, "0")}
            </span>
          </div>
          <a href={postHref(entry.lead!)} class="story-tile group mt-2.5 block">
            <p class="story-headline font-display text-base leading-[1.16] font-bold text-balance">
              {entry.lead!.data.title}
            </p>
            <p class="mt-2 font-mono text-[11px] text-muted-foreground">
              {formatDate(entry.lead!.data.date)}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
