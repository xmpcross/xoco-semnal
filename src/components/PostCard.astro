---
import { Image } from "astro:assets";
import CategoryTag from "@/components/CategoryTag.astro";
import { formatDate, getReadMinutes, postHref, type Post } from "@/lib/posts";

interface Props {
  post: Post;
  variant?: "hero" | "lead" | "medium" | "horizontal" | "ranked" | "editor";
  rank?: number;
  eager?: boolean;
}

const { post, variant = "medium", rank, eager = false } = Astro.props;
const href = postHref(post);
const data = post.data;
const image = data.cover;
const dateLabel = formatDate(data.date);
const readLabel = `${getReadMinutes(post)} min`;
const imageLoading = eager ? "eager" : "lazy";
---

{
  variant === "hero" && (
    <a href={href} class="story-tile group relative block">
      <div class="story-frame settle relative aspect-square sm:aspect-[16/11]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 720, 960, 1200, 1600]}
          sizes="(min-width: 1024px) 66vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
        <div class="image-scrim" aria-hidden="true" />
        <div class="absolute inset-x-0 bottom-0 max-w-4xl p-5 md:p-8 lg:p-10">
          <CategoryTag category={data.category} size="md" tone="onImage" />
          <h2 class="mt-4 font-display text-[clamp(1.7rem,7vw,2.4rem)] leading-[1.02] font-extrabold text-balance text-white md:text-[clamp(2.1rem,4vw,3.35rem)]">
            {data.title}
          </h2>
          <p class="mt-3 max-w-2xl text-pretty text-white/85 md:text-lg">{data.excerpt}</p>
          <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/80">
            <span>By {data.author.name}</span>
            <span aria-hidden="true">/</span>
            <span class="font-mono text-xs">
              {dateLabel} / {readLabel}
            </span>
          </p>
        </div>
      </div>
    </a>
  )
}

{
  variant === "lead" && (
    <a href={href} class="story-tile group block">
      <div class="story-frame aspect-[16/10]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="pt-5">
        <CategoryTag category={data.category} />
        <h3 class="story-headline mt-3 font-display text-2xl leading-[1.05] font-bold text-balance md:text-[2.1rem]">
          {data.title}
        </h3>
        <p class="mt-3 max-w-xl text-pretty text-muted-foreground">{data.excerpt}</p>
        <p class="mt-4 flex flex-wrap items-center justify-between gap-3 font-mono text-[11px] text-muted-foreground">
          <span class="text-foreground">By {data.author.name}</span>
          <span>
            {dateLabel} / {readLabel}
          </span>
        </p>
      </div>
    </a>
  )
}

{
  variant === "medium" && (
    <a href={href} class="story-tile group flex h-full flex-col">
      <div class="story-frame aspect-[16/10]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 480, 720, 960]}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="flex flex-1 flex-col pt-4">
        <CategoryTag category={data.category} />
        <h3 class="story-headline mt-2.5 font-display text-lg leading-[1.15] font-bold text-balance md:text-xl">
          {data.title}
        </h3>
        <p class="mt-auto flex items-center justify-between gap-3 pt-3 font-mono text-[11px] text-muted-foreground">
          <span>{dateLabel}</span>
          <span>{readLabel}</span>
        </p>
      </div>
    </a>
  )
}

{
  variant === "horizontal" && (
    <a
      href={href}
      class="story-tile group grid grid-cols-[84px_minmax(0,1fr)] items-start gap-4 border-b border-border py-4 last:border-b-0 sm:grid-cols-[104px_minmax(0,1fr)]"
    >
      <div class="story-frame aspect-square">
        <Image
          src={image.src}
          alt={image.alt}
          width={240}
          height={240}
          loading={imageLoading}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="min-w-0">
        <CategoryTag category={data.category} />
        <h3 class="story-headline mt-2 font-display text-base leading-[1.18] font-bold text-balance md:text-[1.05rem]">
          {data.title}
        </h3>
        <p class="mt-2 font-mono text-[11px] text-muted-foreground">
          {dateLabel} / {readLabel}
        </p>
      </div>
    </a>
  )
}

{
  variant === "ranked" && (
    <a
      href={href}
      class="story-tile group grid min-h-32 grid-cols-[3.25rem_minmax(0,1fr)] gap-5 border-t border-border pt-4 pb-6 sm:grid-cols-[3.75rem_minmax(0,1fr)]"
    >
      <span class="font-mono text-3xl leading-none font-normal text-muted-foreground/45 transition-colors group-hover:text-primary md:text-4xl">
        {String(rank ?? 1).padStart(2, "0")}
      </span>
      <span class="min-w-0">
        <CategoryTag category={data.category} />
        <span class="story-headline mt-2 block font-display text-xl leading-[1.14] font-bold text-balance lg:text-2xl">
          {data.title}
        </span>
        <span class="mt-2 block font-mono text-[11px] text-muted-foreground">
          {dateLabel} / {readLabel}
        </span>
      </span>
    </a>
  )
}

{
  variant === "editor" && (
    <a href={href} class="story-tile group relative block">
      <div class="story-frame relative aspect-[4/5]">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 480, 720, 960]}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          loading={imageLoading}
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="image-scrim" aria-hidden="true" />
        <span class="eyebrow absolute top-4 left-4 bg-primary px-2 py-1 text-primary-foreground">
          Editor's pick
        </span>
        <div class="absolute inset-x-0 bottom-0 p-5">
          <CategoryTag category={data.category} tone="onImage" />
          <h3 class="mt-2.5 font-display text-[clamp(1.1rem,2.2vw,1.5rem)] leading-[1.12] font-bold text-balance text-white">
            {data.title}
          </h3>
        </div>
      </div>
    </a>
  )
}
