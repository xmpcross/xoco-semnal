---
import PostCard from "@/components/PostCard.astro";
import type { Post } from "@/lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const popularPosts = posts.slice(0, 6);
---

<section class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-10" aria-labelledby="popular-heading">
  <div class="section-rule rule-top"></div>
  <div class="mt-4 mb-7 flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <div class="max-w-xl">
      <h2
        id="popular-heading"
        class="font-display text-3xl leading-[0.98] font-extrabold md:text-[2.6rem]"
      >
        Most read
      </h2>
      <p class="mt-2.5 text-pretty text-sm leading-6 text-muted-foreground">
        What the newsroom's readers opened most in the last seven days.
      </p>
    </div>
    <a
      href="/all-news/"
      class="button-quiet inline-flex min-h-9 items-center px-3.5 font-mono text-[10px] font-semibold tracking-[0.22em] uppercase"
    >
      View archive
    </a>
  </div>
  <div class="grid-cards col-rules-3 grid gap-x-8 md:grid-cols-3">
    {popularPosts.map((post, index) => <PostCard post={post} variant="ranked" rank={index + 1} />)}
  </div>
</section>
