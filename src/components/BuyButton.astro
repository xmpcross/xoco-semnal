---
// Demo-only "Buy theme" pill, shown on the xocoweb demo and localhost. Delete this file to remove it.
const href = "https://buy.polar.sh/polar_cl_TqF100Gmhd1dAv1BqaMkEYgzJNGnRSulpivo60Vko9G";
---

<a class="buy-template" href={href} target="_blank" rel="noopener" data-buy-theme hidden>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
    <path d="M3 6h18"></path>
    <path d="M16 10a4 4 0 0 1-8 0"></path>
  </svg>
  <span>Buy theme</span>
</a>
<script is:inline>
  if (/(^|.)xocoweb.workers.dev$|^localhost$|^127.0.0.1$/.test(location.hostname)) {
    document.querySelector("[data-buy-theme]")?.removeAttribute("hidden");
  }
</script>

<style>
  .buy-template {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 30;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 13px 0 12px;
    border-radius: 11px;
    background: #fff;
    color: #000;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      "Segoe UI",
      sans-serif;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    -webkit-font-smoothing: antialiased;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.05),
      0 0.6px 1.6px -1.5px rgba(0, 0, 0, 0.17),
      0 2.3px 6px -3px rgba(0, 0, 0, 0.14),
      0 10px 26px -4.5px rgba(0, 0, 0, 0.02);
    transition: box-shadow 0.2s ease;
  }

  .buy-template[hidden] {
    display: none;
  }

  .buy-template:hover {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.08),
      0 0.6px 1.6px -1.5px rgba(0, 0, 0, 0.2),
      0 2.3px 6px -3px rgba(0, 0, 0, 0.18),
      0 10px 26px -4.5px rgba(0, 0, 0, 0.08);
  }

  .buy-template:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  .buy-template svg {
    flex: none;
    display: block;
  }

  @media print {
    .buy-template {
      display: none;
    }
  }
</style>
