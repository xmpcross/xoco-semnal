---
import shareNetwork from "@/icons/phosphor/share-network.svg?raw";

/**
 * Opens the page's `<ShareSheet>`. A page can carry several of these — the one
 * under an article's byline and the one at the end of the reading — and they
 * all drive the single sheet the page rendered.
 */
interface Props {
  /** The `id` of the sheet this opens. */
  sheetId?: string;
  /**
   * `quiet`  an inline text control, for a byline row
   * `button` an outlined button, for the end of an article
   */
  variant?: "quiet" | "button";
  label?: string;
  class?: string;
}

const {
  sheetId = "share-sheet",
  variant = "quiet",
  label = variant === "button" ? "Share this article" : "Share",
  class: className = "",
} = Astro.props;

const size = variant === "button" ? 15 : 14;
const glyph = shareNetwork.replace("<svg", `<svg width="${size}" height="${size}"`);
---

<button
  type="button"
  class:list={[
    variant === "button"
      ? "button-quiet inline-flex min-h-10 items-center gap-2 px-4"
      : "share-inline",
    "eyebrow",
    className,
  ]}
  aria-haspopup="dialog"
  aria-controls={sheetId}
  data-share-open
>
  <span class="share-glyph" aria-hidden="true" set:html={glyph} />
  <span>{label}</span>
</button>

<style>
  .share-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 0;
    background: none;
    padding: 0;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: color 200ms var(--ease-out);
  }

  .share-inline:hover {
    color: var(--primary);
  }

  .share-glyph {
    display: inline-grid;
    place-items: center;
  }

  .share-glyph :global(svg) {
    display: block;
  }
</style>
